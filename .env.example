# Copy to .env and fill in. Never commit .env.

# AssemblyAI - used for Tier B transcription (diarization + custom vocabulary).
# Get a key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Anthropic - used for the proper-noun correction pass and (later) insight generation.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Hosting (Turso + API auth) ---------------------------------------------
# Hosted database (Turso). When set, the app reads/writes the cloud DB instead of
# the local file. Get these with: turso db show --url <db>  /  turso db tokens create <db>
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# Shared secret the web API requires (X-API-Key). Unset = open (local dev).
# DIGEST_API_KEY=
# Comma-separated allowed browser origins for CORS (only needed if a browser calls
# the API directly; the Vercel proxy makes this optional).
# DIGEST_CORS_ORIGINS=https://your-app.vercel.app

# --- Background ingestion (Refresh Feeds -> transcribe) ----------------------
# "Refresh Feeds" dispatches the GitHub `ingest` workflow (ffmpeg + transcription)
# for the chosen date range. Requires a GitHub fine-grained PAT with "Actions: write"
# on the repo. Leave unset to keep Refresh discovery-only.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=dav-s-git/research-digest
# INGEST_WORKFLOW=ingest.yml
# INGEST_REF=main

# Optional overrides (defaults shown).
# DIGEST_DATA_DIR=./data
# DIGEST_DB_PATH=./data/digest.db
# DIGEST_CONFIG_DIR=./config
# Anthropic model for high-volume work (extraction, correction, speaker-id, sectors).
# DIGEST_ANTHROPIC_MODEL=claude-sonnet-4-6
# Model for low-volume, high-value synthesis (weekly report + per-episode digest).
# DIGEST_SYNTHESIS_MODEL=claude-opus-4-8
# DIGEST_SYNTHESIS_THINKING=true        # adaptive ("max") reasoning for synthesis
# DIGEST_SYNTHESIS_CONTEXT_1M=true      # enable the 1M-context beta on synthesis
# AssemblyAI model fallback chain (comma-separated, best accuracy first).
# DIGEST_ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2
# HTTP user-agent for feed/audio/transcript fetching.
# DIGEST_USER_AGENT=research-digest/0.1 (+https://localhost)
