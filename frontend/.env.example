# Frontend (Next.js) environment. Copy to .env.local for local dev.

# Backend API base URL (server-side fetches + the /api proxy target).
API_BASE_URL=http://127.0.0.1:8000

# Shared secret sent to the backend (X-API-Key). Server-side only — never exposed
# to the browser. Must match the API's DIGEST_API_KEY in production.
# DIGEST_API_KEY=

# HTTP Basic Auth gate for the whole site. Unset = no gate (local dev).
# Set both in production (Vercel) to keep the site private.
# SITE_USER=
# SITE_PASSWORD=

# Financial Modeling Prep API key (for Hub page live financial data).
# Free tier works fine: https://site.financialmodelingprep.com/
# FMP_API_KEY=

# The Hub "Price & market-moving events" panel is served by the backend itself
# (/api/moves/*) — no separate URL. The backend needs MOVES_POLYGON_API_KEY,
# MOVES_FINNHUB_API_KEY and MOVES_ANTHROPIC_API_KEY set (see backend .env / Render).
